<?xml version="1.0"?>
<!-- Drivable Agrobo UGV carrying the perception stack used for training: RGB, depth, semantic + instance
     segmentation and 2D boxes (all from one camera pose, so pixels line up), 3D lidar, IMU, RTK-style GNSS. -->
<sdf version="1.9">
  <model name="agrobo_trainer">
    <link name="chassis">
      <inertial><pose>0 0 0.55 0 0 0</pose><mass>180</mass><inertia><ixx>30</ixx><iyy>45</iyy><izz>55</izz></inertia></inertial>
      <visual name="visual"><geometry><mesh><uri>model://agrobo_ugv_laser/meshes/agrobo_ugv_laser.obj</uri></mesh></geometry></visual>
      <collision name="body"><pose>0 0 0.75 0 0 0</pose><geometry><box><size>1.7 0.85 0.6</size></box></geometry></collision>
      <sensor name="rgb" type="camera">
        <pose>0.95 0 1.25 0 0.45 0</pose><always_on>1</always_on><update_rate>10</update_rate><topic>agrobo_trainer/camera/image</topic>
        <camera><horizontal_fov>1.2</horizontal_fov><image><width>960</width><height>720</height></image><clip><near>0.1</near><far>60</far></clip></camera>
      </sensor>
      <sensor name="depth" type="depth_camera">
        <pose>0.95 0 1.25 0 0.45 0</pose><always_on>1</always_on><update_rate>10</update_rate><topic>agrobo_trainer/depth/image</topic>
        <camera><horizontal_fov>1.2</horizontal_fov><image><width>960</width><height>720</height></image><clip><near>0.1</near><far>60</far></clip></camera>
      </sensor>
      <sensor name="semantic" type="segmentation">
        <pose>0.95 0 1.25 0 0.45 0</pose><always_on>1</always_on><update_rate>10</update_rate><topic>agrobo_trainer/segmentation/semantic</topic>
        <camera><horizontal_fov>1.2</horizontal_fov><image><width>960</width><height>720</height></image><clip><near>0.1</near><far>60</far></clip><segmentation_type>semantic</segmentation_type></camera>
      </sensor>
      <sensor name="instance" type="segmentation">
        <pose>0.95 0 1.25 0 0.45 0</pose><always_on>1</always_on><update_rate>10</update_rate><topic>agrobo_trainer/segmentation/instance</topic>
        <camera><horizontal_fov>1.2</horizontal_fov><image><width>960</width><height>720</height></image><clip><near>0.1</near><far>60</far></clip><segmentation_type>instance</segmentation_type></camera>
      </sensor>
      <sensor name="boxes" type="boundingbox_camera">
        <pose>0.95 0 1.25 0 0.45 0</pose><always_on>1</always_on><update_rate>10</update_rate><topic>agrobo_trainer/boxes</topic>
        <camera><horizontal_fov>1.2</horizontal_fov><image><width>960</width><height>720</height></image><clip><near>0.1</near><far>60</far></clip><box_type>2d</box_type></camera>
      </sensor>
      <sensor name="lidar" type="gpu_lidar"><pose>0.45 0 1.36 0 0 0</pose><always_on>1</always_on><update_rate>10</update_rate><topic>agrobo_trainer/lidar</topic>
        <lidar><scan><horizontal><samples>720</samples><min_angle>-3.1416</min_angle><max_angle>3.1416</max_angle></horizontal>
          <vertical><samples>16</samples><min_angle>-0.26</min_angle><max_angle>0.26</max_angle></vertical></scan><range><min>0.3</min><max>40</max></range></lidar></sensor>
      <sensor name="imu" type="imu"><always_on>1</always_on><update_rate>100</update_rate><topic>agrobo_trainer/imu</topic></sensor>
      <sensor name="navsat" type="navsat"><always_on>1</always_on><update_rate>10</update_rate><topic>agrobo_trainer/navsat</topic></sensor>
    </link>
    <link name="wheel_fl"><pose>0.62 0.55 0.33 -1.5708 0 0</pose>
      <inertial><mass>8</mass><inertia><ixx>0.25</ixx><iyy>0.25</iyy><izz>0.44</izz></inertia></inertial>
      <collision name="c"><geometry><cylinder><radius>0.33</radius><length>0.22</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>0.8</mu2></ode></friction></surface></collision>
    </link>
    <link name="wheel_fr"><pose>0.62 -0.55 0.33 -1.5708 0 0</pose>
      <inertial><mass>8</mass><inertia><ixx>0.25</ixx><iyy>0.25</iyy><izz>0.44</izz></inertia></inertial>
      <collision name="c"><geometry><cylinder><radius>0.33</radius><length>0.22</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>0.8</mu2></ode></friction></surface></collision>
    </link>
    <link name="wheel_rl"><pose>-0.62 0.55 0.33 -1.5708 0 0</pose>
      <inertial><mass>8</mass><inertia><ixx>0.25</ixx><iyy>0.25</iyy><izz>0.44</izz></inertia></inertial>
      <collision name="c"><geometry><cylinder><radius>0.33</radius><length>0.22</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>0.8</mu2></ode></friction></surface></collision>
    </link>
    <link name="wheel_rr"><pose>-0.62 -0.55 0.33 -1.5708 0 0</pose>
      <inertial><mass>8</mass><inertia><ixx>0.25</ixx><iyy>0.25</iyy><izz>0.44</izz></inertia></inertial>
      <collision name="c"><geometry><cylinder><radius>0.33</radius><length>0.22</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>0.8</mu2></ode></friction></surface></collision>
    </link>
    <joint name="wheel_fl_joint" type="revolute"><parent>chassis</parent><child>wheel_fl</child><axis><xyz>0 0 1</xyz></axis></joint>
    <joint name="wheel_fr_joint" type="revolute"><parent>chassis</parent><child>wheel_fr</child><axis><xyz>0 0 1</xyz></axis></joint>
    <joint name="wheel_rl_joint" type="revolute"><parent>chassis</parent><child>wheel_rl</child><axis><xyz>0 0 1</xyz></axis></joint>
    <joint name="wheel_rr_joint" type="revolute"><parent>chassis</parent><child>wheel_rr</child><axis><xyz>0 0 1</xyz></axis></joint>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_fl_joint</left_joint><left_joint>wheel_rl_joint</left_joint>
      <right_joint>wheel_fr_joint</right_joint><right_joint>wheel_rr_joint</right_joint>
      <wheel_separation>1.1</wheel_separation><wheel_radius>0.33</wheel_radius><max_linear_velocity>1.5</max_linear_velocity>
      <topic>agrobo_trainer/cmd_vel</topic><odom_topic>agrobo_trainer/odometry</odom_topic><frame_id>odom</frame_id><child_frame_id>agrobo_trainer/chassis</child_frame_id>
    </plugin>
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher"><publish_model_pose>true</publish_model_pose><use_pose_vector_msg>false</use_pose_vector_msg></plugin>
    <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label"><label>6</label></plugin>
  </model>
</sdf>
