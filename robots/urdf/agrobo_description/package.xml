<?xml version="1.0"?>
<package format="3">
  <name>agrobo_description</name>
  <version>0.1.0</version>
  <description>Agrobo HM-1 harvester (AB-1 base, 2x FR5-class arms, EE-1 gripper): URDF, meshes, ros2_control config, Gazebo launch.</description>
  <maintainer email="dev@agrobo.example">Agrobo</maintainer>
  <license>Proprietary</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>diff_drive_controller</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>forward_command_controller</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
