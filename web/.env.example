# Public URL of the deployed site (used for metadata / Open Graph).
NEXT_PUBLIC_SITE_URL=https://agrobo.example.com

# Where early-access signups go. Any endpoint that accepts a JSON POST works
# (Slack incoming webhook, Zapier, Make, Formspree, your CRM).
# If unset, signups are appended to web/.data/waitlist.jsonl (fine locally, not on serverless hosts).
WAITLIST_WEBHOOK_URL=
